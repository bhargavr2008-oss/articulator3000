# Copy to .env.local and fill in. .env.local is gitignored — never commit secrets.

# Server-only. Used by API routes for synthesis, grilling, transcription tokens,
# and image generation. Never exposed to the browser.
OPENAI_API_KEY=sk-...

# Optional: override the realtime transcription model (defaults to gpt-4o-transcribe).
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional: override the vision-capable synthesis model (defaults to gpt-5.4-mini).
# OPENAI_SYNTHESIS_MODEL=gpt-5.4-mini

# Optional: override visual generation (defaults to gpt-image-2).
# OPENAI_IMAGE_MODEL=gpt-image-2

# Recommended for deployed frozen share links. Created automatically when a
# public Vercel Blob store is connected to the project. Local development falls
# back to an in-memory store when this is absent.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Optional: OpenAI text-to-speech model/voice for Grill questions.
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
